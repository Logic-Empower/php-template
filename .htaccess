RewriteEngine On

RewriteRule ^(\.env|composer\.(json|lock))$ - [F,L]
RewriteRule ^(database|includes|src|vendor|views)(/|$) - [F,L]

RewriteRule ^$ public/index.php [L]
RewriteRule ^(.+\.(?:css|js|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot|map))$ public/$1 [L,NC]
RewriteRule ^.*$ public/index.php [L]
