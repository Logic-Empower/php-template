APP_NAME="PHP Template"
APP_TIMEZONE="Asia/Beirut"

# Production
# APP_DEBUG=false
# APP_ENV=production
# APP_BASE_PATH=/home/www/domain.com

#Dev
APP_DEBUG=true
APP_ENV=local
APP_BASE_PATH=phptemplate

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=phptemplate
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SMTP_HOST=
SMTP_PORT=465
SMTP_AUTH=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=ssl

MAIL_FROM_ADDRESS=${SMTP_USERNAME}
MAIL_FROM_NAME=${APP_NAME}
CONTACT_TO_EMAIL=
